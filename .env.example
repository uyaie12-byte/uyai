# Mailchimp — the real newsletter backend. Every /api/subscribe submission
# creates (or updates) a member on this Audience, tagged with the source it
# came from (home/article/footer/about/the-camp/popup).
#   MAILCHIMP_API_KEY:     Account -> Extras -> API keys. Keep the "-usNN"
#                           suffix, it's the datacenter the API lives on.
#   MAILCHIMP_AUDIENCE_ID: Audience -> Settings -> Audience name and defaults
#                           ("Audience ID", ~10 chars).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Optional extra: every /api/subscribe submission is also POSTed here as
# raw JSON, alongside Mailchimp — { "email", "source", "createdAt" }. Handy
# for a Slack/Zapier notification on new signups; not required.
SUBSCRIBE_WEBHOOK_URL=
