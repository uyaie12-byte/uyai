# Copy this file to .env for local development with `vercel dev`.
# In production, set these as Environment Variables in the Vercel
# project dashboard instead (Project → Settings → Environment Variables)
# — never commit real values.

# Account → Extras → API keys in Mailchimp. Looks like:
#   abc123def456abc123def456abc123-us21
MAILCHIMP_API_KEY=

# Audience → Settings → Audience name and defaults → Audience ID.
MAILCHIMP_AUDIENCE_ID=

# Optional — normally inferred from the suffix of the API key above
# (the "us21" in the example key). Only set this if that inference
# is wrong for your account.
# MAILCHIMP_SERVER_PREFIX=us21

# Optional — "true" to require confirmation-email opt-in (Mailchimp's
# "pending" status) instead of subscribing immediately. Defaults to false.
# MAILCHIMP_DOUBLE_OPTIN=false
