# Beehiiv — the real newsletter backend. Every /api/subscribe submission
# creates (or reactivates) a subscription on this publication, tagged with
# the source it came from (home/article/footer/about/the-camp/popup) via
# utm_medium. Get both from the Beehiiv dashboard:
#   Settings -> Integrations -> API  (API key; publication ID starts with "pub_")
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Optional extra: every /api/subscribe submission is also POSTed here as
# raw JSON, alongside Beehiiv — { "email", "source", "createdAt" }. Handy
# for a Slack/Zapier notification on new signups; not required.
SUBSCRIBE_WEBHOOK_URL=
